---
import "../styles/global.css";

// Update this when the production domain is confirmed
const SITE_URL = "https://grooveathome.com";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: "it" | "en";
  ogImage?: string;
  canonical?: string;
}

const {
  title = "Groove at Home — Italian Funk & Nu-Jazz Collective",
  description = "Groove at Home is a funk & nu-jazz collective based in Italy, with 40K+ followers, 635K monthly reach and 120+ musicians. Available for live shows across Europe.",
  keywords = "funk band Italy, funk collective, nu-jazz Italy, live funk band Europe, groove collective, book live band Italy, funk jazz live band, musicians Italy, funky live music",
  lang = "en",
  ogImage = `${SITE_URL}/android-chrome-512x512.png`,
  canonical = SITE_URL,
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": "Groove at Home",
  "url": SITE_URL,
  "description": description,
  "genre": ["Funk", "Nu-Jazz", "Soul", "R&B", "Jazz Fusion"],
  "foundingLocation": {
    "@type": "Place",
    "addressCountry": "IT",
    "name": "Italy"
  },
  "sameAs": [
    "https://instagram.com/grooveathome",
    "https://tiktok.com/@grooveathome",
    "https://youtube.com/@grooveathome",
    "https://open.spotify.com/intl-it/artist/4HQd9KulsgMrdOL9kwP4re"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "athomegroove@gmail.com",
    "contactType": "booking"
  }
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Groove at Home" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Groove at Home" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Groove at Home — Italian Funk Collective" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="it_IT" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Groove at Home — Italian Funk Collective" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;500;600;700;800;900&display=swap">
  </head>
  <body>
    <!-- Fixed Side Navigation (Desktop) -->
    <nav id="side-nav" class="fixed left-0 top-1/2 -translate-y-1/2 z-50 hidden lg:block">
      <div class="flex flex-col gap-8 p-4">
        <a href="#home" class="nav-link group" data-section="home">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Home
            </span>
          </div>
        </a>
        <a href="#bio" class="nav-link group" data-section="bio">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Bio
            </span>
          </div>
        </a>
        <a href="#videos" class="nav-link group" data-section="videos">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Videos
            </span>
          </div>
        </a>
        <a href="#music" class="nav-link group" data-section="music">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Music
            </span>
          </div>
        </a>
        <a href="#live" class="nav-link group" data-section="live">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Live
            </span>
          </div>
        </a>
        <a href="#metrics" class="nav-link group" data-section="metrics">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Impact
            </span>
          </div>
        </a>
        <a href="#collaborations" class="nav-link group" data-section="collaborations">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Artists
            </span>
          </div>
        </a>
        <a href="#booking" class="nav-link group" data-section="booking">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Book Us
            </span>
          </div>
        </a>
      </div>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="fixed top-6 right-6 z-50 lg:hidden glass p-3 rounded-full hover:bg-white/10 transition-colors">
      <svg id="menu-icon" class="w-6 h-6 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path class="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        <path class="menu-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Navigation Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-40 lg:hidden pointer-events-none opacity-0 transition-opacity duration-300">
      <div class="mobile-overlay absolute inset-0 bg-black/90 backdrop-blur-sm" id="mobile-overlay"></div>
      <nav class="mobile-panel absolute right-0 top-0 h-full w-full sm:w-80 bg-[var(--bg-secondary)] transform translate-x-full transition-transform duration-300 overflow-y-auto">
        <div class="p-8 pt-24">
          <div class="space-y-6">
            <a href="#home" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Home</a>
            <a href="#bio" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Bio</a>
            <a href="#videos" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Videos</a>
            <a href="#music" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Music</a>
            <a href="#live" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Live</a>
            <a href="#metrics" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Impact</a>
            <a href="#collaborations" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Collaborations</a>
            <a href="#booking" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Book Us</a>
          </div>
        </div>
      </nav>
    </div>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Scripts -->
    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileOverlay = document.getElementById('mobile-overlay');
      const mobilePanel = mobileMenu?.querySelector('.mobile-panel');
      const menuIcon = document.getElementById('menu-icon');
      const menuOpenPath = menuIcon?.querySelector('.menu-open');
      const menuClosePath = menuIcon?.querySelector('.menu-close');
      
      let isMenuOpen = false;

      function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        
        if (isMenuOpen) {
          // Open menu
          mobileMenu?.classList.remove('pointer-events-none', 'opacity-0');
          mobileMenu?.classList.add('pointer-events-auto', 'opacity-100');
          mobilePanel?.classList.remove('translate-x-full');
          mobilePanel?.classList.add('translate-x-0');
          menuOpenPath?.classList.add('hidden');
          menuClosePath?.classList.remove('hidden');
          document.body.style.overflow = 'hidden'; // Prevent scroll
        } else {
          // Close menu
          mobileMenu?.classList.add('pointer-events-none', 'opacity-0');
          mobileMenu?.classList.remove('pointer-events-auto', 'opacity-100');
          mobilePanel?.classList.add('translate-x-full');
          mobilePanel?.classList.remove('translate-x-0');
          menuOpenPath?.classList.remove('hidden');
          menuClosePath?.classList.add('hidden');
          document.body.style.overflow = ''; // Restore scroll
        }
      }

      // Toggle on button click
      mobileMenuBtn?.addEventListener('click', toggleMenu);

      // Close on overlay click
      mobileOverlay?.addEventListener('click', toggleMenu);
      
      // Close mobile menu on link click
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          if (isMenuOpen) {
            toggleMenu();
          }
        });
      });

      // Intersection Observer for section highlighting
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-link');
      
      const observerOptions = {
        rootMargin: '-50% 0px -50% 0px',
        threshold: 0
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(link => {
              const section = link.getAttribute('data-section');
              const dot = link.querySelector('.nav-dot');
              
              if (section === id) {
                dot?.classList.add('active');
              } else {
                dot?.classList.remove('active');
              }
            });
          }
        });
      }, observerOptions);
      
      sections.forEach(section => {
        observer.observe(section);
      });

      // Reveal animations on scroll
      const reveals = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
      });
      
      reveals.forEach(el => {
        revealObserver.observe(el);
      });

      // Smooth scroll behavior
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href') || '');
          target?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        });
      });
    </script>
  </body>
</html>