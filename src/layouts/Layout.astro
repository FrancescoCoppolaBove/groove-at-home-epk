---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "it" | "en";
}

const {
  title = "Groove at Home — Modern Funk Collective",
  description = "Italian funk/nu-jazz collective delivering modern grooves. 40K+ followers, viral content, unforgettable live shows.",
  lang = "it"
} = Astro.props;

const isEN = lang === "en";
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/og-image.jpg" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body>
    <!-- Fixed Side Navigation -->
    <nav id="side-nav" class="fixed left-0 top-1/2 -translate-y-1/2 z-50 hidden lg:block">
      <div class="flex flex-col gap-8 p-4">
        <a href="#home" class="nav-link group" data-section="home">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Home
            </span>
          </div>
        </a>
        <a href="#metrics" class="nav-link group" data-section="metrics">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Impact
            </span>
          </div>
        </a>
        <a href="#music" class="nav-link group" data-section="music">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Music
            </span>
          </div>
        </a>
        <a href="#videos" class="nav-link group" data-section="videos">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Videos
            </span>
          </div>
        </a>
        <a href="#press" class="nav-link group" data-section="press">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Press
            </span>
          </div>
        </a>
        <a href="#booking" class="nav-link group" data-section="booking">
          <div class="flex items-center gap-3">
            <div class="nav-dot group-hover:w-12"></div>
            <span class="nav-label opacity-0 group-hover:opacity-100 transition-opacity text-sm text-white/70 whitespace-nowrap">
              Book Us
            </span>
          </div>
        </a>
      </div>
    </nav>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="fixed top-6 right-6 z-50 lg:hidden glass p-3 rounded-full">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Mobile Navigation Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-40 lg:hidden pointer-events-none">
      <div class="mobile-overlay absolute inset-0 bg-black/80 opacity-0 transition-opacity duration-300"></div>
      <nav class="mobile-panel absolute right-0 top-0 h-full w-80 bg-[var(--bg-secondary)] transform translate-x-full transition-transform duration-300">
        <div class="p-8 pt-20">
          <div class="space-y-6">
            <a href="#home" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Home</a>
            <a href="#metrics" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Impact & Numbers</a>
            <a href="#music" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Music</a>
            <a href="#videos" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Videos</a>
            <a href="#press" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Press</a>
            <a href="#booking" class="mobile-nav-link block text-xl font-semibold hover:text-[var(--accent-primary)] transition-colors">Book Us</a>
          </div>
          
          <div class="mt-12 pt-8 border-t border-white/10">
            <a href={isEN ? "/" : "/en/"} class="inline-flex items-center gap-2 text-sm text-white/70 hover:text-white">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
              {isEN ? "Italiano" : "English"}
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- Fixed Booking Button -->
    <!-- <div class="fixed bottom-8 right-8 z-40">
      <a href="#booking" class="btn-primary flex items-center gap-2 group">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="hidden sm:inline">{isEN ? "Book Now" : "Prenota Ora"}</span>
        <span class="sm:hidden">Book</span>
      </a>
    </div> -->

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Scripts -->
    <script>
      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileOverlay = mobileMenu?.querySelector('.mobile-overlay');
      const mobilePanel = mobileMenu?.querySelector('.mobile-panel');
      
      mobileMenuBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.contains('menu-open');
        
        if (isOpen) {
          mobileMenu?.classList.remove('menu-open');
          mobileMenu?.classList.remove('pointer-events-auto');
          mobileOverlay?.classList.remove('opacity-100');
          mobilePanel?.classList.remove('translate-x-0');
        } else {
          mobileMenu?.classList.add('menu-open');
          mobileMenu?.classList.add('pointer-events-auto');
          mobileOverlay?.classList.add('opacity-100');
          mobilePanel?.classList.add('translate-x-0');
        }
      });
      
      // Close mobile menu on link click
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.remove('menu-open');
          mobileMenu?.classList.remove('pointer-events-auto');
          mobileOverlay?.classList.remove('opacity-100');
          mobilePanel?.classList.remove('translate-x-0');
        });
      });

      // Intersection Observer for section highlighting
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-link');
      
      const observerOptions = {
        rootMargin: '-50% 0px -50% 0px',
        threshold: 0
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(link => {
              const section = link.getAttribute('data-section');
              const dot = link.querySelector('.nav-dot');
              
              if (section === id) {
                dot?.classList.add('active');
              } else {
                dot?.classList.remove('active');
              }
            });
          }
        });
      }, observerOptions);
      
      sections.forEach(section => {
        observer.observe(section);
      });

      // Reveal animations on scroll
      const reveals = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
      });
      
      reveals.forEach(el => {
        revealObserver.observe(el);
      });

      // Smooth scroll behavior
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          target?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        });
      });
    </script>
  </body>
</html>