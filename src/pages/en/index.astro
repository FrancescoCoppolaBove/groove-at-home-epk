---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Bio from "../../components/Bio.astro";
import SellingPoints from "../../components/SellingPoints.astro";
import PressKit from "../../components/PressKit.astro";
import Quotes from "../../components/Quotes.astro";
import Media from "../../components/Media.astro";
import CTA from "../../components/CTA.astro";

const meta = {
  tagline:
    "Italian funk/nu-jazz collective delivering modern grooves with a warm, retro-inspired aesthetic. Young, fresh and technically tight: interplay, creativity and contagious stage presence.",
  heroImage: "/assets/hero.jpg",
  kpis: { instagram: "40k", tiktok: "13k", er: "5.75%", reelAvg: "50k", topVideo: "416k" },
  email: "grooveathomeofficial@gmail.com",
  quickFacts: [
    "Format: 6 musicians (vocals/guitar, bass, drums, keys, trumpet, sax)",
    "Genre: Funk · Nu-Jazz · Soul",
    "USP: Freshness · Youth · Stage Power",
    "EU Mini-Tour 2026: Milan · London · Frankfurt",
  ],
};

const bioShort = `Groove at Home is an Italian funk/nu-jazz collective founded by drummer <strong>Francesco Coppola Bove</strong>. Born as a home-studio project, it quickly evolved into a live ensemble known for deep grooves, modern arrangements and a strong retro-modern aesthetic. With over <strong>40,000 followers</strong> on Instagram, collaborations with <strong>Mario Biondi</strong> and <strong>Francesca Tandoi</strong>, and a community of more than <strong>100 musicians</strong>, the band delivers a vibrant and irresistible live set.`;

const bioLong = [
  `Founded in 2023 by <strong>Francesco Coppola Bove</strong>, Groove at Home aims to bring something fresh and artistically relevant to Italy, rooted in funk and soul. From home-studio to stage: boosted by social growth and an expanding network of musicians, the project evolved into a live collective reimagining Italian and international songs with a blend of <em>vintage funk</em>, <em>modern soul</em> and <em>nu-jazz</em>.`,
  `Led by core members <strong>Francesco Coppola Bove</strong> (drums) and <strong>Gianmaria Salerno</strong> (vocals/guitar), the collective counts 100+ musicians across Italy. The 70–90 minute set alternates reinterpretations and original music to be featured on their debut studio album (2026).`,
];

const selling = [
  { title: "Live Impact", points: ["Engaging shows, powerful grooves, real interplay.", "Young, fresh, technically tight."] },
  { title: "Unique Identity", points: ["70s funk × modern soul × contemporary nu-jazz.", "A distinctive sound in Italy."] },
  { title: "Digital Relevance", points: ["Active community: 40k IG, 13k TikTok.", "Viral content: up to 416k views."] },
];

const press = {
  genre: "Modern Funk, Nu-Jazz, Soul, Retro-Groove",
  influences: "Vulfpeck · Snarky Puppy · Lettuce · Scary Pockets · Earth, Wind & Fire · Jordan Rakei · Yussef Dayes",
  setup: [
    "Vocals/Guitar — Gianmaria Salerno",
    "Bass",
    "Drums — Francesco Coppola Bove",
    "Keys",
    "Trumpet",
    "Saxophone",
  ],
  setInfo: "70–90 minute set · Reinterpretations + originals",
  stages: [
    "Italian jazz festivals",
    "Official partnership with Thomann",
    "100+ musicians in the collective",
    "Collabs: Mario Biondi, Francesca Tandoi, Arabella Rustico",
    "EU Mini-Tour (Feb–Mar 2026): BIKO · Crazy Coqs · Das Wohnzimmer",
  ],
  kpis: meta.kpis,
  usp: ["Freshness", "Youth", "Stage Power"],
};

const quotes = [
  { text: "One of the freshest funk projects emerging from Italy.", source: "Jazz Italia" },
  { text: "Young energy and surprisingly mature musicianship.", source: "Roma in Jazz" },
  { text: "A retro-modern groove that truly hits on stage.", source: "Soul & Beyond Magazine" },
];

const media = {
  links: [
    { href: "https://www.instagram.com/reel/DQOzdJqgrXS/", label: "Reel #1" },
    { href: "https://www.instagram.com/reel/DI6OIPmspPu/", label: "Reel #2" },
    { href: "https://www.instagram.com/reel/C8zK9aYoEke/", label: "Reel #3" },
    { href: "https://www.instagram.com/reel/DO3GnMylTOU/", label: "Top video (416k)" },
    { href: "https://www.instagram.com/reel/DNalchUsi_T/", label: "Live Highlights" },
  ],
  gallery: {
    main: "/assets/gallery-1.jpg",
    sideA: "/assets/gallery-2.jpg",
    sideB: "/assets/gallery-3.jpg",
  },
};
---

<Layout lang="en" title="Groove at Home — EPK" description="Modern Funk. Italian Soul. Collective Energy.">
  <Hero meta={{ tagline: meta.tagline, heroImage: meta.heroImage, kpis: meta.kpis }} />
  <Bio shortHtml={bioShort} longHtml={bioLong} />
  <SellingPoints blocks={selling} />
  <PressKit {...press} />
  <Quotes items={quotes} />
  <Media links={media.links} gallery={media.gallery} />
  <CTA email={meta.email} quickFacts={meta.quickFacts} />
</Layout>