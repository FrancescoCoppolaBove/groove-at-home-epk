---

<Layout 
  title="Groove at Home — Modern Italian Funk Collective | EPK"
  description="40K+ followers, viral content creator, unforgettable live performances. Book Italy's hottest funk/nu-jazz collective for your venue or festival."
  lang="it"
>
  <Hero {...heroData} />
  <MetricsSection {...metricsData} />
  <VideoShowcase {...videosData} />
  <MusicSection {...musicData} />
  
  <!-- Press Section -->
  <section id="press" class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[var(--accent-secondary)] rounded-full filter blur-3xl"></div>
    </div>
    
    <div class="relative z-10 container-max section-padding">
      <div class="text-center mb-16 reveal">
        <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
          Press & Reviews
        </span>
        <h2 class="text-4xl md:text-5xl font-black mb-4">
          <span class="gradient-text">What They Say</span>
        </h2>
      </div>
      
      <!-- Press Quotes Carousel -->
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="glass-card reveal">
          <div class="text-6xl text-[var(--accent-primary)] opacity-20 mb-4">"</div>
          <p class="text-lg mb-4">One of the freshest and most contemporary funk projects in Italy today.</p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--accent-primary)] to-[var(--accent-secondary)]"></div>
            <div>
              <div class="font-semibold">Jazz Italia</div>
              <div class="text-sm text-[var(--text-tertiary)]">Music Magazine</div>
            </div>
          </div>
        </div>
        
        <div class="glass-card reveal" style="animation-delay: 0.1s">
          <div class="text-6xl text-[var(--accent-primary)] opacity-20 mb-4">"</div>
          <p class="text-lg mb-4">Young energy combined with surprisingly mature musicianship.</p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--accent-primary)] to-[var(--accent-secondary)]"></div>
            <div>
              <div class="font-semibold">Roma in Jazz</div>
              <div class="text-sm text-[var(--text-tertiary)]">Festival Director</div>
            </div>
          </div>
        </div>
        
        <div class="glass-card reveal" style="animation-delay: 0.2s">
          <div class="text-6xl text-[var(--accent-primary)] opacity-20 mb-4">"</div>
          <p class="text-lg mb-4">A retro-modern groove that truly hits differently on stage.</p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[var(--accent-primary)] to-[var(--accent-secondary)]"></div>
            <div>
              <div class="font-semibold">Soul & Beyond</div>
              <div class="text-sm text-[var(--text-tertiary)]">Music Blog</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Collaborations -->
      <div class="mt-16 text-center reveal">
        <h3 class="text-xl font-bold mb-6 text-[var(--text-secondary)]">Featured Collaborations</h3>
        <div class="flex flex-wrap gap-8 justify-center items-center">
          <div class="text-lg font-semibold opacity-60 hover:opacity-100 transition-opacity">Mario Biondi</div>
          <div class="text-lg font-semibold opacity-60 hover:opacity-100 transition-opacity">Francesca Tandoi</div>
          <div class="text-lg font-semibold opacity-60 hover:opacity-100 transition-opacity">Arabella Rustico</div>
          <div class="text-lg font-semibold opacity-60 hover:opacity-100 transition-opacity">Thomann</div>
        </div>
      </div>
      
      <!-- Downloads -->
      <div class="mt-16 flex justify-center gap-4 reveal">
        <a href="/assets/epk-onepage.pdf" class="btn-glass">
          <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download Press Kit
        </a>
        <a href="/assets/tech-rider.pdf" class="btn-glass">
          <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Tech Rider
        </a>
      </div>
    </div>
  </section>
  
  <BookingSection {...bookingData} />
  
  <!-- Footer -->
  <footer class="py-12 border-t border-white/10">
    <div class="container-max px-6 text-center">
      <div class="flex justify-center gap-6 mb-8">
        <a href="https://instagram.com/grooveathome" target="_blank" class="p-3 rounded-full glass hover:bg-white/10 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
            <path d="M12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998z"/>
            <circle cx="18.406" cy="5.594" r="1.44"/>
          </svg>
        </a>
        <a href="https://tiktok.com/@grooveathome" target="_blank" class="p-3 rounded-full glass hover:bg-white/10 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
        <a href="https://youtube.com/@grooveathome" target="_blank" class="p-3 rounded-full glass hover:bg-white/10 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
        <a href="https://spotify.com/grooveathome" target="_blank" class="p-3 rounded-full glass hover:bg-white/10 transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
        </a>
      </div>
      
      <div class="text-[var(--text-tertiary)]">
        <p class="mb-2">© 2025 Groove at Home · Electronic Press Kit</p>
        <p class="text-sm">Modern Funk · Italian Soul · Collective Energy</p>
      </div>
    </div>
  </footer>
</Layout>