---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import BioSection from "../components/BioSection.astro";
import MusicSection from "../components/MusicSection.astro";
import LiveSection from "../components/LiveSection.astro";
import VideoShowcase from "../components/VideoShowcase.astro";
import MetricsSection from "../components/MetricsSection.astro";
import CollaboratorsSection from "../components/CollaboratorsSection.astro";
import BookingSection from "../components/BookingSection.astro";

// ── Hero ──────────────────────────────────────────────────
const heroData = {
  metrics: {
    instagram: "40K+",
    musicians: "120+",
    viral: "416K",
    engagement: "5.75"
  }
};

// ── Metrics ───────────────────────────────────────────────
const metricsData = {
  stats: {
    followers: {
      value: "40K+",
      label: "Total Followers",
      growth: "18% this month"
    },
    engagement: {
      value: "5.75%",
      label: "Engagement Rate",
      detail: "Above industry avg"
    },
    reach: {
      value: "635K",
      label: "Monthly Reach",
      platforms: ["Instagram", "TikTok", "YouTube"]
    },
    partnership: {
      value: "Thomann",
      label: "Official Partner",
      detail: "Thomann Artist"
    }
  }
};

// ── Instagram Reels ───────────────────────────────────────
const reels = [
  "https://www.instagram.com/reel/DQOzdJqgrXS/", // Francesca Tandoi
  "https://www.instagram.com/reel/DO3GnMylTOU/", // Thomann collab
  "https://www.instagram.com/p/DI6OIPmspPu/",    // Leave a Message
  "https://www.instagram.com/reel/DMkh8IbMCoB/", // Little Blue (Jacob Collier)
  "https://www.instagram.com/reel/DMAcue5o30y/", // Miglior arrangiamento
  "https://www.instagram.com/p/DF0EI_JsQv0/",    // Gabriele Esposito
];

// ── Booking ───────────────────────────────────────────────
const bookingData = {
  email: "athomegroove@gmail.com",
  // ── ADD UPCOMING TOUR DATES HERE ─────────────────────────
  // Each entry: { date, venue, city, status: 'confirmed'|'available'|'sold-out' }
  // Optional:   ticketsEnabled: true, ticketsUrl: 'https://...'
  // ─────────────────────────────────────────────────────────
  tour: {
    dates: [
      { date: "Aug 10, 2026", venue: "Kroton Jazz Festival 2026", city: "Crotone, IT", status: "confirmed" as const },
      { date: "Aug 11, 2026", venue: "Kroton Jazz Festival 2026", city: "Crotone, IT", status: "confirmed" as const },
      { date: "Aug 12, 2026", venue: "Kroton Jazz Festival 2026", city: "Crotone, IT", status: "confirmed" as const },
      { date: "Aug 13, 2026",    venue: "Ferragosto Sannazzareno",           city: "San Nazzaro (BN), IT", status: "confirmed" as const },
      { date: "Jul 5, 2025",     venue: "Nocera Jazz Festival",       city: "Nocera Inferiore, IT", status: "past" as const },
      { date: "Jul 26, 2025",     venue: "Renanera",       city: "Torre Annunziata, IT", status: "past" as const },
      { date: "Feb 24, 2026",     venue: "BIKO",       city: "Milan, IT", status: "past" as const },
      { date: "Feb 26, 2026",     venue: "Crazy Coqs",       city: "London, UK", status: "past" as const },
      { date: "Feb 28, 2026",     venue: "Das Wohnzimmer",       city: "Wiesbaden, DE", status: "past" as const },
    ]
  }
};
---

<Layout
  title="Groove at Home — Italian Funk & Nu-Jazz Collective | Live Shows Europe"
  description="Groove at Home is a funk & nu-jazz collective based in Italy, with 40K+ followers, 635K monthly reach and 120+ musicians. Book us for your venue or festival across Europe."
  keywords="funk band Italy, nu-jazz collective, groove at home, live funk band Europe, book live band Italy, funk jazz live, soul band Italy, groove musicians, funk collective live show"
  lang="en"
>
  <!-- 1. HOOK: Who we are, immediate credibility -->
  <Hero {...heroData} />

  <!-- 2. TRUST: Quick credibility signals — removes first objections -->
  <TrustBar />

  <!-- 3. STORY: Origin and artistic identity — emotional connection -->
  <BioSection />

  <!-- 4. SOUND: Let them experience the music directly -->
  <MusicSection />

  <!-- 5. LIVE: Visual proof of stage presence and energy -->
  <LiveSection />

  <!-- 6. SOCIAL PROOF: Instagram reels — viral content, reach, engagement -->
  <VideoShowcase reels={reels} />

  <!-- 7. NUMBERS: Data-driven proof for industry professionals -->
  <MetricsSection {...metricsData} />

  <!-- 8. NETWORK: Social proof via artist collaborations -->
  <CollaboratorsSection />

  <!-- 9. CTA: Conversion — book us for your event -->
  <BookingSection {...bookingData} />

  <!-- Footer -->
  <footer class="py-12 border-t border-white/10 bg-[var(--bg-secondary)]">
    <div class="container-max px-6 text-center">

      <!-- Social links -->
      <div class="flex justify-center gap-5 mb-8">
        <a href="https://instagram.com/grooveathome" target="_blank" rel="noopener" aria-label="Instagram"
          class="social-link">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
            <path d="M12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998z"/>
            <circle cx="18.406" cy="5.594" r="1.44"/>
          </svg>
        </a>
        <a href="https://tiktok.com/@grooveathome" target="_blank" rel="noopener" aria-label="TikTok"
          class="social-link">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
        <a href="https://youtube.com/@grooveathome" target="_blank" rel="noopener" aria-label="YouTube"
          class="social-link">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
        <a href="https://open.spotify.com/intl-it/artist/4HQd9KulsgMrdOL9kwP4re?si=hChu_b37RU-vEO7T-YV4hg"
          target="_blank" rel="noopener" aria-label="Spotify"
          class="social-link">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
        </a>
      </div>

      <!-- Footer copy -->
      <div class="text-[var(--text-tertiary)] text-sm">
        <p class="mb-1 font-playfair italic text-base text-[var(--text-secondary)]">
          "The groove is always at home."
        </p>
        <p class="mt-3">© 2026 Groove at Home</p>
        <p class="mt-1">
          <a href="mailto:athomegroove@gmail.com" class="text-[var(--accent-primary)] hover:underline transition-all">
            athomegroove@gmail.com
          </a>
        </p>
      </div>

    </div>
  </footer>

</Layout>

<style>
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.7);
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(247,181,56,0.12);
    border-color: rgba(247,181,56,0.4);
    color: var(--accent-primary);
    transform: translateY(-3px);
  }
</style>
