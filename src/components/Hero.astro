---
import { Image } from 'astro:assets';
import bandPhoto from '../assets/band_photo-min.jpg';
import bandLogo from '../assets/Groove_transparent_logo.png';

interface Props {
  metrics: {
    instagram: string;
    tiktok: string;
    viral: string;
    engagement: string;
  };
}

const { metrics } = Astro.props;
---

<section id="home" class="relative min-h-screen flex items-start justify-center overflow-hidden pt-16 md:pt-24 lg:pt-28">
  <!-- Background Image with Parallax Effect -->
  <div class="absolute inset-0 z-0">
    <div class="hero-image-container absolute inset-0 scale-110">
      <Image 
        src={bandPhoto} 
        alt="Groove at Home Band" 
        class="w-full h-full object-cover object-[center_20%]"
        loading="eager"
        quality={90}
        format="webp"
      />
    </div>
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-max px-6 md:px-12 lg:px-20 text-center">
    <!-- Logo Animation -->
    <div class="mb-8 fade-in">
      <div class="inline-flex items-center justify-center w-32 h-32 rounded-full logo-container floating">
        <Image 
          src={bandLogo} 
          alt="Groove at Home Logo" 
          class="w-24 h-24 object-contain"
          loading="eager"
          quality={90}
        />
      </div>
    </div>

    <!-- Title -->
    <h1 class="text-6xl md:text-7xl lg:text-8xl font-black mb-4 fade-in" style="animation-delay: 0.2s">
      <span class="gradient-text">Groove at Home</span>
    </h1>
    
    <!-- Tagline with better contrast -->
    <div class="tagline-container mb-12 fade-in max-w-3xl mx-auto" style="animation-delay: 0.4s">
      <p class="text-xl md:text-2xl font-semibold">
        Italian Funk/Nu-Jazz Collective · Modern Grooves
      </p>
    </div>

    <!-- Floating Metrics with improved readability -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 fade-in" style="animation-delay: 0.6s">
      <div class="metric-card-hero group">
        <div class="relative z-10">
          <div class="text-3xl md:text-4xl font-black metric-number mb-1">{metrics.instagram}</div>
          <div class="text-sm font-bold uppercase tracking-wider metric-label">Instagram</div>
        </div>
      </div>
      <div class="metric-card-hero group">
        <div class="relative z-10">
          <div class="text-3xl md:text-4xl font-black metric-number mb-1">{metrics.tiktok}</div>
          <div class="text-sm font-bold uppercase tracking-wider metric-label">TikTok</div>
        </div>
      </div>
      <div class="metric-card-hero group">
        <div class="relative z-10">
          <div class="text-3xl md:text-4xl font-black metric-number mb-1">{metrics.viral}</div>
          <div class="text-sm font-bold uppercase tracking-wider metric-label">Top Video</div>
        </div>
      </div>
      <div class="metric-card-hero group">
        <div class="relative z-10">
          <div class="text-3xl md:text-4xl font-black metric-number mb-1">{metrics.engagement}%</div>
          <div class="text-sm font-bold uppercase tracking-wider metric-label">Engagement</div>
        </div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center fade-in" style="animation-delay: 0.8s">
      <a href="#booking" class="btn-primary">
        Book Us Now
      </a>
      <a href="#music" class="btn-glass-hero">
        <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Watch & Listen
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="scroll-indicator">
    <svg class="w-6 h-6 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes subtle-zoom {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1.15);
    }
  }
  
  .fade-in {
    opacity: 0;
    animation: fade-in-up 0.8s ease-out forwards;
  }
  
  .hero-image-container {
    animation: subtle-zoom 20s ease-in-out alternate infinite;
  }
  
  .hero-overlay {
    background: linear-gradient(
      180deg,
      rgba(10, 10, 15, 0.5) 0%,
      rgba(10, 10, 15, 0.7) 50%,
      rgba(10, 10, 15, 0.85) 100%
    );
  }
  
  /* Logo container with transparent center and colored border */
  .logo-container {
    border: 3px solid;
    border-color: var(--accent-primary);
    background: transparent;
    position: relative;
    overflow: visible;
  }
  
  .logo-container::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-tertiary));
    z-index: -1;
    opacity: 0.8;
  }
  
  /* Tagline with backdrop for better readability */
  .tagline-container {
    /* padding: 1rem 2rem;
    border-radius: 100px;
    border: 1px solid rgba(247, 181, 56, 0.2); */
  }
  
  .tagline-container p {
    color: var(--accent-primary);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  
  /* Improved metric cards for hero */
  .metric-card-hero {
    backdrop-filter: blur(20px);
    border: 2px solid rgba(247, 181, 56, 0.3);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: all 0.3s ease;
    margin-top: 5rem;
  }
  
  .metric-card-hero:hover {
    transform: translateY(-5px) scale(1.05);
    border-color: var(--accent-primary);
    cursor:default;
  }
  
  .metric-number {
    color: var(--accent-primary);
    text-shadow: 0 2px 20px rgba(247, 181, 56, 0.5);
  }
  
  .metric-label {
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
  }
  
  /* Better glass button for hero */
  .btn-glass-hero {
    background: rgba(10, 10, 15, 0.7);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(247, 181, 56, 0.4);
    color: white;
    padding: 1rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
  }
  
  .btn-glass-hero:hover {
    background: rgba(247, 181, 56, 0.2);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }
</style>