---
interface Video {
  src: string;
  poster: string;
  title: string;
  views: string;
  platform: 'instagram' | 'tiktok' | 'youtube';
}

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;

const platformIcons = {
  instagram: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/><path d="M12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998z"/><circle cx="18.406" cy="5.594" r="1.44"/></svg>`,
  tiktok: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
  youtube: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
};
---

<section id="videos" class="py-24 bg-[var(--bg-secondary)]">
  <div class="container-max section-padding">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
        Social Impact
      </span>
      <h2 class="text-4xl md:text-5xl font-black mb-4">
        <span class="gradient-text">Viral Content</span>
      </h2>
      <p class="text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Our performances reach millions across social platforms
      </p>
    </div>

    <!-- Video Carousel Container -->
    <div class="relative">
      <!-- Navigation Buttons -->
      <button class="video-nav-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 p-3 rounded-full glass hover:bg-white/10 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <button class="video-nav-next absolute right-0 top-1/2 -translate-y-1/2 z-10 p-3 rounded-full glass hover:bg-white/10 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <!-- Videos Grid -->
      <div class="video-carousel overflow-x-auto pb-4">
        <div class="flex gap-6 w-max">
          {videos.map((video, index) => (
            <div class="video-card w-80 flex-shrink-0 reveal" style={`animation-delay: ${index * 0.1}s`}>
              <div class="relative aspect-[9/16] rounded-2xl overflow-hidden group cursor-pointer glass">
                <!-- Video -->
                <video 
                  class="w-full h-full object-cover"
                  poster={video.poster}
                  muted
                  loop
                  preload="none"
                  data-video-card
                >
                  <source src={video.src} type="video/mp4" />
                </video>
                
                <!-- Overlay -->
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <div class="absolute bottom-0 left-0 right-0 p-6">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-white" set:html={platformIcons[video.platform]} />
                      <span class="text-white/70 text-sm">{video.views} views</span>
                    </div>
                    <h3 class="text-white font-bold text-lg">{video.title}</h3>
                  </div>
                </div>
                
                <!-- Play Button -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="play-button w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Platform Stats -->
    <div class="mt-12 grid grid-cols-3 gap-6 max-w-2xl mx-auto reveal">
      <div class="text-center">
        <div class="flex justify-center mb-3">
          <div class="p-3 rounded-xl bg-pink-500/20">
            <span class="text-pink-400" set:html={platformIcons.instagram} />
          </div>
        </div>
        <div class="text-2xl font-bold">40K+</div>
        <div class="text-sm text-[var(--text-tertiary)]">Instagram</div>
      </div>
      
      <div class="text-center">
        <div class="flex justify-center mb-3">
          <div class="p-3 rounded-xl bg-white/10">
            <span class="text-white" set:html={platformIcons.tiktok} />
          </div>
        </div>
        <div class="text-2xl font-bold">13K+</div>
        <div class="text-sm text-[var(--text-tertiary)]">TikTok</div>
      </div>
      
      <div class="text-center">
        <div class="flex justify-center mb-3">
          <div class="p-3 rounded-xl bg-red-500/20">
            <span class="text-red-400" set:html={platformIcons.youtube} />
          </div>
        </div>
        <div class="text-2xl font-bold">8K+</div>
        <div class="text-sm text-[var(--text-tertiary)]">YouTube</div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-carousel {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  
  .video-carousel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Video hover play
  const videoCards = document.querySelectorAll('[data-video-card]');
  
  videoCards.forEach(video => {
    if (video instanceof HTMLVideoElement) {
      video.parentElement?.addEventListener('mouseenter', () => {
        video.play();
      });
      
      video.parentElement?.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    }
  });
  
  // Carousel navigation
  const carousel = document.querySelector('.video-carousel');
  const prevBtn = document.querySelector('.video-nav-prev');
  const nextBtn = document.querySelector('.video-nav-next');
  
  prevBtn?.addEventListener('click', () => {
    if (carousel) {
      carousel.scrollBy({ left: -336, behavior: 'smooth' });
    }
  });
  
  nextBtn?.addEventListener('click', () => {
    if (carousel) {
      carousel.scrollBy({ left: 336, behavior: 'smooth' });
    }
  });
</script>