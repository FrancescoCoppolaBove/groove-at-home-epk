---
const { reels = [] } = Astro.props;
---

<section id="videos" class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-6 gradient-text">
      Video • Reels in evidenza
    </h2>
    <p class="text-[var(--text-secondary)] mb-10 max-w-2xl">
      Una selezione dei nostri reel più rappresentativi: collaborazioni, live e arrangiamenti.
    </p>

    <!-- Griglia con larghezze minime per evitare embed schiacciati -->
    <div
      class="grid gap-8 [grid-template-columns:repeat(auto-fit,minmax(360px,1fr))] sm:[grid-template-columns:repeat(auto-fit,minmax(326px,1fr))]"
    >
      {reels.map((url) => (
        <article class="glass-card p-3 rounded-2xl flex justify-center">
          <!-- Placeholder con aspect ratio 9:16 per prevenire CLS e schiacciamento -->
          <div class="w-full max-w-[540px] min-w-[360px] sm:min-w-[326px]">
            <div class="relative w-full aspect-[9/16] overflow-hidden rounded-xl">
              <!-- IG sostituirà questo blockquote con un iframe corretto -->
              <blockquote
                class="instagram-media absolute inset-0 w-full h-full"
                data-instgrm-permalink={url}
                data-instgrm-version="14"
                style="background:#FFF; border:0; border-radius:12px; box-shadow:0 2px 18px rgba(0,0,0,.12); margin:0;"
              >
                <a href={url} target="_blank" rel="noreferrer noopener" class="sr-only">
                  Apri su Instagram
                </a>
              </blockquote>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Carica embed.js una sola volta per pagina e processa dopo render -->
  <script is:inline>
    (function loadIG() {
      const SRC = "https://www.instagram.com/embed.js";
      const process = () => window?.instgrm?.Embeds?.process?.();
      if (![...document.scripts].some((s) => s.src === SRC)) {
        const s = document.createElement("script");
        s.async = true;
        s.src = SRC;
        s.onload = process;
        document.head.appendChild(s);
      } else {
        process();
      }
    })();
  </script>
</section>
