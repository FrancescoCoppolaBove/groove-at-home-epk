---
import IconInstagram from './icons/IconInstagram.astro';

const { reels = [] } = Astro.props;

function getEmbedUrl(postUrl: string): string {
  const match = postUrl.match(/\/(reel|p)\/([A-Za-z0-9_-]+)/);
  if (!match) return '';
  const [, type, id] = match;
  return `https://www.instagram.com/${type}/${id}/embed/`;
}

function getPostType(postUrl: string): string {
  return /\/reel\//.test(postUrl) ? 'Reel' : 'Post';
}
---

<section id="videos" class="relative py-16 md:py-24 overflow-hidden">

  <!-- Soft glow -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full blur-3xl opacity-[0.07]"
      style="background: radial-gradient(closest-side, var(--accent-primary), transparent)"></div>
  </div>

  <div class="relative z-10 container-max section-padding mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <span class="section-eyebrow">On Instagram</span>
      <h2 class="section-heading mb-4">
        A Few Things<br/>
        <em class="gradient-text not-italic">That Took Off.</em>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto mt-3">
        Arrangements, collaborations, live clips. A handful of things we posted that got some traction.
      </p>
      <a
        href="https://instagram.com/grooveathome"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-5 text-sm font-semibold text-[var(--accent-primary)] hover:text-white transition-colors duration-200"
      >
        <IconInstagram class="w-4 h-4" />
        @grooveathome — Follow for more
      </a>
    </div>

    <!-- Grid responsive -->
<div
  class="grid gap-8 place-items-center sm:[grid-template-columns:repeat(auto-fit,minmax(326px,1fr))] mobile-limit-3"
  style="animation-delay:.15s"
>
  {reels.map((url) => (
    <article class="glass-card p-3 rounded-2xl w-full max-w-[326px] ig-wrap mx-auto ig-card" data-embed-src={getEmbedUrl(url)}>
      <button
        type="button"
        class="ig-facade relative w-full aspect-[9/16] overflow-hidden rounded-xl"
        aria-label={`Play Instagram ${getPostType(url)}`}
      >
        <span class="ig-facade-icon" aria-hidden="true">
          <IconInstagram class="w-8 h-8" />
        </span>
        <span class="ig-facade-play" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="ig-facade-label">View {getPostType(url)}</span>
      </button>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center text-xs text-[var(--text-tertiary)] mt-2 hover:text-[var(--accent-primary)] transition-colors"
      >
        Open on Instagram ↗
      </a>
    </article>
  ))}
</div>
  </div>

</section>

<hr class="vintage-divider" />

<style>
.ig-wrap { margin-left: auto; margin-right: auto; }

@media (max-width: 380px) {
  .ig-wrap { width: 92vw; }
}

@media (max-width: 640px) {
  .mobile-limit-3 { justify-items: center; }
}

.ig-card :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

.ig-facade {
  display: block;
  border: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  font: inherit;
  background: linear-gradient(145deg, var(--accent-secondary), var(--accent-blue));
}

.ig-facade-icon {
  position: absolute;
  top: 1rem;
  left: 1rem;
  color: rgba(255, 255, 255, 0.85);
}

.ig-facade-play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3.25rem;
  height: 3.25rem;
  margin: auto;
  border-radius: 9999px;
  background: rgba(10, 10, 15, 0.55);
  backdrop-filter: blur(6px);
  color: #fff;
  border: 1.5px solid rgba(255, 255, 255, 0.5);
  transition: transform 0.25s ease, background 0.25s ease;
}

.ig-facade:hover .ig-facade-play {
  transform: scale(1.1);
  background: var(--accent-primary);
  border-color: var(--accent-primary);
}

.ig-facade-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0.75rem 1rem;
  background: linear-gradient(to top, rgba(10,10,15,0.85), transparent);
  color: #fff;
  font-size: 0.8rem;
  font-weight: 600;
  text-align: left;
}
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ig-card').forEach((card) => {
    const btn = card.querySelector('.ig-facade');
    const embedSrc = card.dataset.embedSrc;
    if (!btn || !embedSrc) return;

    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = embedSrc;
      iframe.allowFullscreen = true;
      iframe.setAttribute('scrolling', 'no');
      iframe.title = 'Instagram post';
      btn.replaceWith(iframe);
    }, { once: true });
  });
</script>