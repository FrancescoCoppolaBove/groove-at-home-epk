---
const { reels = [] } = Astro.props;
---

<section id="videos" class="py-16 md:py-24">
  <div class="container-max section-padding mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
        Watch Us
      </span>
      <h2 class="text-3xl md:text-5xl font-black mb-4">
        <span class="gradient-text">Featured Reels</span>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Highlights from our collaborations, live performances, and unique arrangements
      </p>
    </div>

    <!-- Grid responsive -->
<div
  class="grid gap-8 place-items-center sm:[grid-template-columns:repeat(auto-fit,minmax(326px,1fr))] mobile-limit-3"
  style="animation-delay:.15s"
>
  {reels.map((url) => (
    <article class="glass-card p-3 rounded-2xl w-full max-w-[540px] ig-wrap mx-auto">
      <div class="w-full">
        <div class="relative w-full aspect-[9/16] overflow-hidden rounded-xl">
          <blockquote
            class="instagram-media absolute inset-0 w-full h-full ig-embed"
            data-instgrm-permalink={url}
            data-instgrm-version="14"
            style="background:#FFF; border:0; border-radius:12px; box-shadow:0 2px 18px rgba(0,0,0,.12); margin:0;"
          >
            <a href={url} target="_blank" rel="noreferrer noopener" class="sr-only">
              Open on Instagram
            </a>
          </blockquote>
        </div>
      </div>
    </article>
  ))}
</div>
  </div>

  <script is:inline>
    (function loadIG() {
      const SRC = "https://www.instagram.com/embed.js";
      const process = () => window?.instgrm?.Embeds?.process?.();
      if (![...document.scripts].some((s) => s.src === SRC)) {
        const s = document.createElement("script");
        s.async = true;
        s.src = SRC;
        s.onload = process;
        document.head.appendChild(s);
      } else {
        process();
      }
    })();
  </script>
</section>
<style>
  /* === IG embed hardening (mobile) === */
.ig-wrap { margin-left: auto; margin-right: auto; }

@media (max-width: 380px) {
  /* Forza wrapper a stare dentro il viewport */
  .ig-wrap { width: 92vw; }

  /* Instagram inietta min/max width sul container: li superiamo */
  .ig-wrap .instagram-media,
  .ig-wrap .ig-embed,
  .ig-wrap .instagram-media > * {
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
  }
}

/* Centra sempre gli articoli della griglia su mobile */
@media (max-width: 640px) {
  .mobile-limit-3 { justify-items: center; }
}

</style>