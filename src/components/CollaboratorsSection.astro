---
interface Collaborator {
  name: string;
  size?: "lg" | "md" | "sm";
}

const collaborators: Collaborator[] = [
  { name: "Mario Biondi", size: "lg" },
  { name: "Francesca Tandoi", size: "lg" },
  { name: "Arabella Rustico", size: "lg" },
  { name: "Thomann", size: "lg"},

  { name: "Roberta Gentile", size: "md" },
  { name: "Fabiana Martone", size: "md" },
  { name: "Nausica", size: "md" },
  { name: "Folcast", size: "md" },
  { name: "Roberto Colella", size: "md" },

  { name: "Zoe Ranno", size: "sm" },
  { name: "Corinne Ragona", size: "sm" },
  { name: "Alex Polidori", size: "sm" },
  { name: "Greg Rega", size: "sm" },
];
---

<section id="collaborations" class="py-20 md:py-24 relative overflow-hidden">
  <!-- Soft background lights -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-32 left-10 w-[500px] h-[500px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-secondary), transparent)"></div>
    <div class="absolute -bottom-32 right-0 w-[600px] h-[600px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-primary), transparent)"></div>
  </div>

  <div class="relative z-10 container-max section-padding px-4 sm:px-6 md:px-12 lg:px-20">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16 reveal">
      <span class="section-eyebrow">Who We've Worked With</span>
      <h2 class="font-playfair text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
        The Names<br/>
        <em class="gradient-text not-italic">Behind the Groove</em>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto mt-3">
        Collaborations with acclaimed Italian and international artists. Proof that the best musicians are listening.
      </p>
    </div>

    <!-- Word Cloud -->
    <div class="relative mx-auto max-w-5xl reveal" style="animation-delay:.15s">
      <div class="flex flex-wrap justify-center gap-3 sm:gap-4 md:gap-6 px-4">
        {collaborators.map(c => (
          <span
            class={`word-item font-bold transition-all duration-300 hover:scale-110 cursor-default
              ${c.size === "lg" ? "text-2xl sm:text-3xl md:text-4xl lg:text-5xl" : ""}
              ${c.size === "md" ? "text-xl sm:text-2xl md:text-3xl" : ""}
              ${c.size === "sm" ? "text-base sm:text-lg md:text-xl" : ""}
            `}
            style="color:var(--accent-quaternary);"
          >
            {c.name}
          </span>
        ))}
      </div>
    </div>

    <!-- Musician stats -->
    <div class="mt-16 md:mt-20 reveal" style="animation-delay:.3s">
      <p class="text-center text-sm uppercase tracking-widest text-[var(--text-secondary)] mb-8 font-semibold">
        Musicians in our network
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4 md:gap-6 max-w-5xl mx-auto px-4">
        {[
          { count: "44", label: "Singers" },
          { count: "23", label: "Keyboardists" },
          { count: "20", label: "Bassists" },
          { count: "16", label: "Guitarists" },
          { count: "10", label: "Saxophonists" },
          { count: "7",  label: "Trumpeters" },
          { count: "2",  label: "Drummers" },
        ].map(stat => (
          <div class="stat-card text-center">
            <span class="block text-3xl md:text-4xl font-bold gradient-text leading-none">{stat.count}</span>
            <span class="block text-xs md:text-sm text-[var(--text-secondary)] mt-1 font-medium">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .stat-card {
      padding: 1rem 0.5rem;
      border-radius: 0.75rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      transition: border-color 0.25s ease, transform 0.25s ease;
    }
    .stat-card:hover {
      border-color: rgba(247,181,56,0.3);
      transform: translateY(-3px);
    }

    .word-item {
      position: relative;
      display: inline-block;
      animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }

    .word-item:nth-child(odd)  { animation-delay: .2s; }
    .word-item:nth-child(3n)   { animation-delay: .6s; }
    .word-item:nth-child(4n)   { animation-delay: .4s; }
    .word-item:nth-child(5n)   { animation-delay: .8s; }
    .word-item:nth-child(6n)   { animation-delay: 1s; }
  </style>
</section>