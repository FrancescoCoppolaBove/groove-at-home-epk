---
/** MusicSection – solo embed Spotify in griglia responsive */
---

<section id="music" class="py-24 relative overflow-hidden">
  <!-- Background soffuso -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px]">
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--accent-primary)]/15 to-[var(--accent-secondary)]/15 rounded-full blur-3xl animate-pulse"></div>
    </div>
  </div>

  <div class="relative z-10 container-max section-padding">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <span class="section-eyebrow">Listen Now · Spotify</span>
      <h2 class="font-playfair text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-3 leading-tight">
        Close Your Eyes.<br/>
        <em class="gradient-text not-italic">Feel the Groove.</em>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto mt-3">
        Modern Italian funk and nu-jazz. Arrangements that breathe, rhythms that move, and a sound entirely our own.
      </p>
    </div>

    <!-- Griglia embed -->
    <div 
      class="grid gap-8 md:gap-10 mobile-limit-3"
      style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));"
    >
      <!-- Ogni card usa un wrapper glass + radius coerente con lo stile -->
      <div class="glass rounded-3xl p-3">
        <iframe 
          data-testid="embed-iframe" 
          style="border-radius:12px"
          src="https://open.spotify.com/embed/track/3qtF4IPMShN4etHuVu7pcX?utm_source=generator" 
          width="100%" height="352"
          allowfullscreen=""
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <div class="glass rounded-3xl p-3">
        <iframe data-testid="embed-iframe" style="border-radius:12px"
          src="https://open.spotify.com/embed/track/3ESeyizygcnrKp13EiDbCe?utm_source=generator"
          width="100%" height="352" allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <div class="glass rounded-3xl p-3">
        <iframe data-testid="embed-iframe" style="border-radius:12px"
          src="https://open.spotify.com/embed/track/2bg5Z9OlgD4ms74mMkrjob?utm_source=generator"
          width="100%" height="352" allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <div class="glass rounded-3xl p-3">
        <iframe data-testid="embed-iframe" style="border-radius:12px"
          src="https://open.spotify.com/embed/track/7ui98HQjJiEb0Xh2rcdZdm?utm_source=generator"
          width="100%" height="352" allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <div class="glass rounded-3xl p-3">
        <iframe data-testid="embed-iframe" style="border-radius:12px"
          src="https://open.spotify.com/embed/track/77PNvRbUc6CmBxBwGHaD8f?utm_source=generator"
          width="100%" height="352" allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>

      <div class="glass rounded-3xl p-3">
        <iframe data-testid="embed-iframe" style="border-radius:12px"
          src="https://open.spotify.com/embed/track/7McoTbxPItWBe9Wsh4OqKK?utm_source=generator"
          width="100%" height="352" allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"></iframe>
      </div>
    </div>

    <!-- Tag/hashtag (opzionale): lascio per coerenza visual -->
    <div class="mt-14 text-center reveal">
      <div class="flex flex-wrap gap-3 justify-center">
        {['Funk', 'Nu-Jazz', 'Soul', 'Groove', 'Italian', 'Modern', 'Live Sessions'].map(tag => (
          <span class="px-4 py-2 rounded-full glass text-sm font-semibold hover:bg-white/10 transition-colors cursor-default">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Piccolo miglioramento: smussa l'iframe nei container */
  .glass :global(iframe){ width:100%; height:352px; border-radius:12px; }
</style>