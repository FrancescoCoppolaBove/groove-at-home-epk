---
interface Track {
  title: string;
  duration: string;
  plays: string;
  featured?: boolean;
}

interface Props {
  tracks: Track[];
  spotifyEmbed?: string;
}

const { tracks, spotifyEmbed } = Astro.props;
---

<section id="music" class="py-24 relative overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px]">
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--accent-primary)]/20 to-[var(--accent-secondary)]/20 rounded-full filter blur-3xl animate-pulse"></div>
    </div>
  </div>

  <div class="relative z-10 container-max section-padding">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
        Listen Now
      </span>
      <h2 class="text-4xl md:text-5xl font-black mb-4">
        <span class="gradient-text">Our Sound</span>
      </h2>
      <p class="text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Modern funk meets Italian soul - experience the groove
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Track List -->
      <div class="reveal">
        <div class="glass rounded-3xl p-8">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-20 h-20 rounded-xl bg-gradient-to-br from-[var(--accent-primary)] to-[var(--accent-secondary)] flex items-center justify-center">
              <svg class="w-10 h-10 text-black" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-bold">Latest Tracks</h3>
              <p class="text-[var(--text-secondary)]">Our top performances</p>
            </div>
          </div>

          <div class="space-y-3">
            {tracks.map((track, index) => (
              <div class="track-item group p-4 rounded-xl hover:bg-white/5 transition-all duration-300 cursor-pointer">
                <div class="flex items-center gap-4">
                  <button class="play-btn w-12 h-12 rounded-full bg-white/10 group-hover:bg-[var(--accent-primary)] group-hover:text-black transition-all duration-300 flex items-center justify-center">
                    <svg class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                  
                  <div class="flex-1">
                    <div class="flex items-center gap-2">
                      <h4 class="font-semibold group-hover:text-[var(--accent-primary)] transition-colors">
                        {track.title}
                      </h4>
                      {track.featured && (
                        <span class="px-2 py-1 rounded-full bg-[var(--accent-primary)]/20 text-[var(--accent-primary)] text-xs font-bold">
                          FEATURED
                        </span>
                      )}
                    </div>
                    <div class="flex items-center gap-4 mt-1">
                      <span class="text-sm text-[var(--text-tertiary)]">{track.duration}</span>
                      <span class="text-sm text-[var(--text-tertiary)]">{track.plays} plays</span>
                    </div>
                  </div>
                  
                  <div class="waveform opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="flex items-center gap-1 h-8">
                      {[...Array(5)].map((_, i) => (
                        <div 
                          class="w-1 bg-[var(--accent-primary)] rounded-full animate-pulse" 
                          style={`height: ${Math.random() * 100}%; animation-delay: ${i * 0.1}s`}
                        ></div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8 flex gap-4">
            <a href="https://open.spotify.com" target="_blank" class="btn-glass flex-1 text-center">
              <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
              </svg>
              Spotify
            </a>
            <a href="https://music.apple.com" target="_blank" class="btn-glass flex-1 text-center">
              <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.997 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.988c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18 0 .032-.007.062-.01.093v12.223c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.801.42.127.856.187 1.293.228.555.053 1.11.06 1.667.06h11.03c.525 0 1.048-.034 1.57-.1.823-.106 1.597-.35 2.296-.81a4.58 4.58 0 001.675-1.688c.3-.469.516-.99.65-1.541.147-.6.18-1.21.215-1.82.007-.123.01-.246.013-.37V8.124v-2zm-6.424 3.99v5.712c0 .417-.058.827-.244 1.206-.29.59-.76.962-1.388 1.14-.35.1-.706.157-1.07.173-.95.045-1.773-.6-1.943-1.536a1.88 1.88 0 011.038-2.022c.323-.16.67-.25 1.018-.324.378-.082.758-.153 1.134-.24.274-.063.457-.23.51-.516a.904.904 0 00.02-.193c.003-1.74 0-3.48.002-5.22a.865.865 0 00-.15-.583c-.197-.297-.57-.419-.904-.296-.604.22-1.198.463-1.797.688-.763.29-1.527.576-2.291.863-.458.172-.748.5-.856.973-.017.073-.023.148-.023.223v7.306c0 .466-.086.9-.303 1.29-.366.663-.967 1.053-1.691 1.177a3.136 3.136 0 01-1.247-.036c-.724-.173-1.264-.623-1.507-1.347-.096-.29-.117-.588-.103-.893.023-.473.157-.895.445-1.262.325-.414.758-.678 1.256-.82.493-.14.993-.23 1.492-.35.274-.066.542-.143.8-.258.386-.172.571-.504.605-.943.008-.11.01-.22.01-.33V8.05c0-.611.037-.58.574-.736 1.072-.312 2.143-.625 3.216-.933.595-.17 1.193-.333 1.788-.505.243-.07.477-.166.714-.252.205-.074.422-.135.641-.172.164-.028.327-.063.493-.065.286-.003.577.104.73.336.132.204.158.447.153.7l.003 4.88z"/>
              </svg>
              Apple Music
            </a>
          </div>
        </div>
      </div>

      <!-- Spotify Embed or Visual Player -->
      <div class="reveal" style="animation-delay: 0.2s">
        {spotifyEmbed ? (
          <div class="spotify-embed rounded-3xl overflow-hidden shadow-2xl" set:html={spotifyEmbed} />
        ) : (
          <div class="visual-player glass rounded-3xl p-8 h-[500px] flex flex-col justify-center items-center">
            <div class="relative mb-8">
              <div class="w-48 h-48 rounded-full bg-gradient-to-r from-[var(--accent-primary)] to-[var(--accent-secondary)] animate-spin-slow"></div>
              <div class="absolute inset-4 rounded-full bg-[var(--bg-primary)] flex items-center justify-center">
                <div class="w-16 h-16 rounded-full bg-gradient-to-r from-[var(--accent-primary)] to-[var(--accent-secondary)]"></div>
              </div>
            </div>
            
            <div class="text-center">
              <h3 class="text-2xl font-bold mb-2">Now Playing</h3>
              <p class="text-[var(--text-secondary)] mb-6">Groove at Home - Live Sessions</p>
              
              <div class="flex items-center gap-4 justify-center">
                <button class="p-3 rounded-full hover:bg-white/10 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                  </svg>
                </button>
                <button class="p-4 rounded-full bg-[var(--accent-primary)] text-black hover:scale-110 transition-transform">
                  <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
                <button class="p-3 rounded-full hover:bg-white/10 transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Genre Tags -->
    <div class="mt-16 text-center reveal">
      <div class="flex flex-wrap gap-3 justify-center">
        {['Funk', 'Nu-Jazz', 'Soul', 'Groove', 'Italian', 'Modern', 'Live Performance'].map(tag => (
          <span class="px-4 py-2 rounded-full glass text-sm font-semibold hover:bg-white/10 transition-colors cursor-pointer">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }
  
  .spotify-embed :global(iframe) {
    border-radius: 1.5rem;
    width: 100%;
    height: 500px;
  }
</style>