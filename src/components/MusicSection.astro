---
/** MusicSection – griglia Spotify con facade: niente iframe finché l'utente non clicca play */

const trackIds = [
  '3qtF4IPMShN4etHuVu7pcX',
  '3ESeyizygcnrKp13EiDbCe',
  '2bg5Z9OlgD4ms74mMkrjob',
  '7ui98HQjJiEb0Xh2rcdZdm',
  '77PNvRbUc6CmBxBwGHaD8f',
  '7McoTbxPItWBe9Wsh4OqKK',
];

// ═══════════════════════════════════════════════════════════
//  HOW TO ADD/SWAP TRACKS
//  ─────────────────────
//  Add/replace an ID in trackIds above — grab it from the Spotify
//  share link (open.spotify.com/track/{ID}). Cover art and title are
//  fetched at build time from Spotify's oEmbed endpoint.
// ═══════════════════════════════════════════════════════════
const tracks = await Promise.all(
  trackIds.map(async (id) => {
    const embedSrc = `https://open.spotify.com/embed/track/${id}?utm_source=generator`;
    try {
      const res = await fetch(`https://open.spotify.com/oembed?url=https://open.spotify.com/track/${id}`);
      if (!res.ok) throw new Error(`oEmbed ${res.status}`);
      const data = await res.json();
      return { id, embedSrc, title: data.title as string, thumbnail: data.thumbnail_url as string };
    } catch {
      return { id, embedSrc, title: null, thumbnail: null };
    }
  })
);
---

<section id="music" class="py-24 relative overflow-hidden">
  <!-- Background soffuso -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px]">
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--accent-primary)]/15 to-[var(--accent-secondary)]/15 rounded-full blur-3xl animate-pulse"></div>
    </div>
  </div>

  <div class="relative z-10 container-max section-padding">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <span class="section-eyebrow">Listen · Spotify</span>
      <h2 class="section-heading mb-3">
        Hear It<br/>
        <em class="gradient-text not-italic">for Yourself.</em>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto mt-3">
        Funk, soul and nu-jazz. A few tracks to get a sense of what we sound like.
      </p>
    </div>

    <!-- Griglia facade: l'iframe pesante si monta solo al click -->
    <div
      class="grid gap-8 md:gap-10 mobile-limit-3"
      style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));"
    >
      {tracks.map((t) => (
        <div class="glass rounded-3xl p-3 track-card" data-embed-src={t.embedSrc}>
          <button
            type="button"
            class="track-facade"
            aria-label={t.title ? `Play "${t.title}" on Spotify` : 'Play track on Spotify'}
          >
            {t.thumbnail ? (
              <img
                src={t.thumbnail}
                alt={t.title ?? 'Spotify track cover'}
                class="track-cover"
                loading="lazy"
                width="300"
                height="300"
              />
            ) : (
              <span class="track-cover track-cover--fallback" aria-hidden="true"></span>
            )}
            <span class="track-play-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            {t.title && <span class="track-title">{t.title}</span>}
          </button>
        </div>
      ))}
    </div>

    <!-- Tag/hashtag (opzionale): lascio per coerenza visual -->
    <div class="mt-14 text-center reveal">
      <div class="flex flex-wrap gap-3 justify-center">
        {['Funk', 'Nu-Jazz', 'Soul', 'Groove', 'Italian', 'Modern', 'Live Sessions'].map(tag => (
          <span class="px-4 py-2 rounded-full glass text-sm font-semibold hover:bg-white/10 transition-colors cursor-default">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .glass :global(iframe){ width:100%; height:352px; border-radius:12px; }

  .track-card { display: flex; }

  .track-facade {
    position: relative;
    display: block;
    width: 100%;
    height: 352px;
    border-radius: 12px;
    overflow: hidden;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: var(--bg-tertiary);
    font: inherit;
  }

  .track-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .track-cover--fallback {
    background: linear-gradient(135deg, var(--accent-secondary), var(--accent-blue));
  }

  .track-facade:hover .track-cover {
    transform: scale(1.04);
    filter: brightness(0.7);
  }

  .track-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: auto;
    border-radius: 9999px;
    background: var(--accent-gradient);
    color: #0a0a0f;
    box-shadow: var(--shadow-glow);
    transition: transform 0.25s ease;
  }

  .track-facade:hover .track-play-icon {
    transform: scale(1.1);
  }

  .track-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.9rem 1rem;
    background: linear-gradient(to top, rgba(10,10,15,0.85), transparent);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.track-card').forEach((card) => {
    const btn = card.querySelector('.track-facade');
    const embedSrc = card.dataset.embedSrc;
    if (!btn || !embedSrc) return;

    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.setAttribute('data-testid', 'embed-iframe');
      iframe.style.borderRadius = '12px';
      iframe.src = embedSrc;
      iframe.width = '100%';
      iframe.height = '352';
      iframe.allowFullscreen = true;
      iframe.setAttribute('allow', 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture');
      btn.replaceWith(iframe);
    }, { once: true });
  });
</script>
