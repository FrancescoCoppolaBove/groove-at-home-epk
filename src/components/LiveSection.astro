---
import { Image } from 'astro:assets';

import live01 from '../assets/foto_live_01.jpeg';
import live02 from '../assets/foto_live_02.jpeg';
import live03 from '../assets/foto_live_03.jpeg';
import live04 from '../assets/foto_live_04.jpeg';
import live05 from '../assets/foto_live_05.jpeg';
import live06 from '../assets/foto_live_06.jpeg';
import live07 from '../assets/foto_live_07.jpeg';
import live08 from '../assets/foto_live_08.jpeg';
import live09 from '../assets/foto_live_09.jpeg';
import live10 from '../assets/foto_live_10.jpeg';

import liveVideo from '../assets/live_video.mp4';

const livePhotos = [
  { src: live01, alt: 'Groove at Home live performance 01' },
  { src: live02, alt: 'Groove at Home live performance 02' },
  { src: live03, alt: 'Groove at Home live performance 03' },
  { src: live04, alt: 'Groove at Home live performance 04' },
  { src: live05, alt: 'Groove at Home live performance 05' },
  { src: live06, alt: 'Groove at Home live performance 06' },
  { src: live07, alt: 'Groove at Home live performance 07' },
  { src: live08, alt: 'Groove at Home live performance 08' },
  { src: live09, alt: 'Groove at Home live performance 09' },
  { src: live10, alt: 'Groove at Home live performance 10' },
];
---

<section id="live" class="relative py-20 md:py-24 overflow-hidden">

  <!-- Soft glow -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 left-0 w-[520px] h-[520px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-secondary), transparent)"></div>
    <div class="absolute -bottom-24 right-0 w-[520px] h-[520px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-primary), transparent)"></div>
  </div>

  <div class="relative container-max px-4 sm:px-6 md:px-12 lg:px-20 reveal">

    <!-- Header -->
    <div class="text-center mb-10 md:mb-12">
      <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
        Experience Us Live
      </span>
      <h2 class="text-3xl md:text-5xl font-black mb-3">
        <span class="gradient-text">On Stage Energy</span>
      </h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Feel the groove, the energy, and the connection with our audience
      </p>
    </div>

    <!-- Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(280px,380px)_1fr] gap-10 lg:gap-12 items-start">

      <!-- VIDEO – always visible first on mobile, sticky only on desktop -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none order-1 lg:order-none">

        <div class="lg:sticky lg:top-24 rounded-2xl overflow-hidden shadow-2xl border border-white/10">
          <div class="relative pt-[177.78%] bg-black">
            <video
              src={liveVideo}
              class="absolute inset-0 w-full h-full object-cover"
              controls
              playsinline
              preload="metadata"
            ></video>
          </div>
        </div>

        <p class="mt-4 text-sm text-[var(--text-tertiary)] text-center lg:text-left">
          Live performance highlights — press play to watch
        </p>

      </div>


      <!-- GALLERY -->
      <div class="order-2 lg:order-none">

        <!-- ✅ DESKTOP — keep your exact masonry layout -->
        <div class="hidden lg:block">
          <div class="columns-1 sm:columns-2 md:columns-3 gap-3 md:gap-4 [column-fill:balance]">
            {livePhotos.map((ph) => (
              <div class="mb-3 md:mb-4 break-inside-avoid rounded-xl md:rounded-2xl overflow-hidden shadow-xl group cursor-pointer">
                <Image
                  src={ph.src}
                  alt={ph.alt}
                  loading="lazy"
                  quality={90}
                  format="webp"
                  class="w-full h-auto block transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- ✅ MOBILE — auto-scrolling carousel -->
        <!-- ✅ MOBILE — auto-scrolling carousel -->
<div class="lg:hidden">
  <div
    id="live-carousel"
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    tabindex="-1"
  >
    {livePhotos.map((ph) => (
      <div class="min-w-[78%] snap-center shrink-0">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <Image
            src={ph.src}
            alt={ph.alt}
            loading="lazy"
            quality={90}
            format="webp"
            class="w-full h-96 object-cover"
          />
        </div>
      </div>
    ))}
  </div>

  <!-- ✅ HINT sotto al carosello (solo mobile) -->
  <div
    id="live-hint"
    class="mt-2 flex items-center justify-center sm:hidden"
    role="status"
    aria-live="polite"
  >
    <span
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/45 backdrop-blur-sm border border-white/10 text-[10.5px] font-semibold tracking-wide text-white/90 shadow-md transition-opacity duration-300"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          d="M8 12h8M8 12l3 3M8 12l3-3" />
      </svg>
      <span class="uppercase">Swipte to browse</span>
      <span class="mx-1 opacity-60">•</span>
      <span class="opacity-90">auto-slides</span>
      <span class="flex items-center gap-1 ml-1 not-italic">
        <span class="dot"></span><span class="dot delay-150"></span><span class="dot delay-300"></span>
      </span>
    </span>
  </div>
</div>

      </div>
    </div>

  </div>

  <!-- Auto-scroll carousel -->
  <script is:inline>
  (function () {
    const track = document.getElementById('live-carousel');
    if (!track) return;

    const AUTOSCROLL_MS = 3500;
    const VIS_THR = 0.5; // almeno 50% visibile
    let timer = null;
    let interacting = false;

    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;

    // calcola larghezza “slide” (card + gap)
    const slideWidth = () => {
      const first = track.querySelector(':scope > *');
      if (!first) return 0;
      const rect = first.getBoundingClientRect();
      // gap-4 ≈ 16px
      return rect.width + 16;
    };

    // è almeno al 50% visibile?
    const isMostlyInView = (el) => {
      const r = el.getBoundingClientRect();
      const vw = window.innerWidth || document.documentElement.clientWidth;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      if (!r.width || !r.height) return false;
      const horiz = Math.max(0, Math.min(r.right, vw) - Math.max(r.left, 0)) / r.width;
      const vert  = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0)) / r.height;
      return horiz >= 0.6 && vert >= VIS_THR;
    };

    const next = () => {
      if (prefersReduced) return;
      if (document.hidden) return;
      if (interacting) return;
      if (!isMostlyInView(track)) return;

      const w = slideWidth();
      if (!w) return;

      const idx = Math.round(track.scrollLeft / w);
      const nextIdx = (idx + 1) % track.children.length;
      track.scrollTo({ left: nextIdx * w, behavior: 'smooth' });
    };

    const start = () => {
      stop();
      if (!prefersReduced && window.innerWidth < 1024) {
        timer = setInterval(next, AUTOSCROLL_MS);
      }
    };

    const stop = () => {
      if (timer) { clearInterval(timer); timer = null; }
    };

    // pausa su interazione
    const pause = () => { interacting = true; stop(); };
    const resume = () => {
      interacting = false;
      if (isMostlyInView(track)) start();
    };

    track.addEventListener('pointerdown', pause, { passive: true });
    track.addEventListener('touchstart',  pause, { passive: true });
    track.addEventListener('mouseenter',  pause, { passive: true });
    track.addEventListener('pointerup',   resume, { passive: true });
    track.addEventListener('touchend',    resume, { passive: true });
    track.addEventListener('mouseleave',  resume, { passive: true });

    // sospendi quando la tab non è visibile
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else resume();
    });

    // ri-valuta su resize
    let rAF;
    const onResize = () => {
      cancelAnimationFrame(rAF);
      rAF = requestAnimationFrame(() => {
        if (!interacting && isMostlyInView(track)) start();
      });
    };
    window.addEventListener('resize', onResize);

    // avvio iniziale
    if (!prefersReduced) start();
  })();
</script>


</section>
<style>
.dot {
  width: 4px; height: 4px; border-radius: 9999px;
  background: rgba(255,255,255,.9);
  display: inline-block;
  animation: hint-pulse 1.2s infinite ease-in-out;
  opacity: .9;
}
.dot.delay-150 { animation-delay: .15s; }
.dot.delay-300 { animation-delay: .3s; }

@keyframes hint-pulse {
  0%, 100% { transform: translateY(0); opacity: .7; }
  50%      { transform: translateY(-2px); opacity: 1; }
}
</style>