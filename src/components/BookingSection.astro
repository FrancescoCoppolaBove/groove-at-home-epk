---
interface Props {
  email: string;
  tour: {
    dates: Array<{
      date: string;
      venue: string;
      city: string;
      status: 'confirmed' | 'available' | 'sold-out';
    }>;
  };
}

const { email, tour } = Astro.props;

const statusColors = {
  'confirmed': 'text-green-400',
  'available': 'text-[var(--accent-primary)]',
  'sold-out': 'text-red-400'
};

const statusLabels = {
  'confirmed': 'Confirmed',
  'available': 'Available',
  'sold-out': 'Sold Out'
};
---

<section id="booking" class="py-24 bg-[var(--bg-secondary)]">
  <div class="container-max section-padding">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="text-[var(--accent-primary)] font-bold text-sm uppercase tracking-wider mb-4 block">
        Book Us
      </span>
      <h2 class="text-4xl md:text-5xl font-black mb-4">
        <span class="gradient-text">Bring The Groove</span>
      </h2>
      <p class="text-xl text-[var(--text-secondary)] max-w-2xl mx-auto">
        Available for clubs, festivals, and private events across Italy & EU
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Booking Form -->
      <div class="reveal">
        <div class="glass-card">
          <h3 class="text-2xl font-bold mb-6">Request Booking</h3>
          
          <form class="space-y-6" data-booking-form>
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                  Your Name *
                </label>
                <input 
                  type="text" 
                  required 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors"
                  placeholder="John Doe"
                />
              </div>
              
              <div>
                <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                  Email *
                </label>
                <input 
                  type="email" 
                  required 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors"
                  placeholder="john@example.com"
                />
              </div>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                  Event Date
                </label>
                <input 
                  type="date" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors"
                />
              </div>
              
              <div>
                <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                  Event Type
                </label>
                <select class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors">
                  <option value="">Select type...</option>
                  <option value="festival">Festival</option>
                  <option value="club">Club Night</option>
                  <option value="corporate">Corporate Event</option>
                  <option value="private">Private Party</option>
                  <option value="wedding">Wedding</option>
                </select>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                Venue / Location
              </label>
              <input 
                type="text" 
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors"
                placeholder="Venue name and city"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold mb-2 text-[var(--text-secondary)]">
                Message
              </label>
              <textarea 
                rows="4"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[var(--accent-primary)] focus:outline-none transition-colors resize-none"
                placeholder="Tell us about your event..."
              ></textarea>
            </div>
            
            <div class="flex gap-4">
              <button type="submit" class="btn-primary flex-1">
                Send Request
              </button>
              <a href={`mailto:${email}`} class="btn-glass flex-1 text-center">
                Direct Email
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Tour Dates & Info -->
      <div class="space-y-6 reveal" style="animation-delay: 0.2s">
        <!-- Quick Info -->
        <div class="glass-card">
          <h3 class="text-2xl font-bold mb-6">Quick Info</h3>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--accent-primary)] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <div class="font-semibold">Set Duration</div>
                <div class="text-sm text-[var(--text-secondary)]">70-90 minutes</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--accent-primary)] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
              <div>
                <div class="font-semibold">Band Format</div>
                <div class="text-sm text-[var(--text-secondary)]">6 musicians (expandable to 8)</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--accent-primary)] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <div class="font-semibold">Availability</div>
                <div class="text-sm text-[var(--text-secondary)]">Italy & EU · Worldwide on request</div>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[var(--accent-primary)] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
              </svg>
              <div>
                <div class="font-semibold">Genre</div>
                <div class="text-sm text-[var(--text-secondary)]">Funk · Nu-Jazz · Soul · Modern Groove</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Upcoming Shows -->
        <div class="glass-card">
          <h3 class="text-2xl font-bold mb-6">2026 Tour Dates</h3>
          <div class="space-y-3">
            {tour.dates.map(show => (
              <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors">
                <div>
                  <div class="font-semibold">{show.venue}</div>
                  <div class="text-sm text-[var(--text-secondary)]">{show.city} · {show.date}</div>
                </div>
                <span class={`text-sm font-semibold ${statusColors[show.status]}`}>
                  {statusLabels[show.status]}
                </span>
              </div>
            ))}
          </div>
          
          <div class="mt-6 p-4 rounded-xl bg-[var(--accent-primary)]/10 border border-[var(--accent-primary)]/20">
            <p class="text-sm">
              <span class="font-semibold text-[var(--accent-primary)]">EU Mini-Tour 2026:</span>
              <span class="text-[var(--text-secondary)]"> Milan (BIKO) · London (Crazy Coqs) · Frankfurt (Das Wohnzimmer)</span>
            </p>
          </div>
        </div>

        <!-- Direct Contact -->
        <div class="glass-card text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-[var(--accent-primary)]/20 to-[var(--accent-secondary)]/20 mb-4">
            <svg class="w-8 h-8 text-[var(--accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h4 class="text-xl font-bold mb-2">Direct Booking</h4>
          <a href={`mailto:${email}`} class="text-[var(--accent-primary)] hover:underline font-semibold">
            {email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('[data-booking-form]');
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Add success animation
    const button = form.querySelector('button[type="submit"]');
    if (button) {
      button.textContent = 'Request Sent!';
      button.classList.add('bg-green-500');
      
      setTimeout(() => {
        button.textContent = 'Send Request';
        button.classList.remove('bg-green-500');
        form.reset();
      }, 3000);
    }
  });
</script>