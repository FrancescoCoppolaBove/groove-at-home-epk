  },
];
---

<div class="trust-bar-section">
  <!-- Static grid for desktop, infinite marquee for mobile -->

  <!-- Desktop grid -->
  <div class="trust-grid-desktop">
    {badges.map(b => (
      <div class={`trust-badge trust-badge--${b.color}`}>
        <span class="trust-icon" set:html={b.icon} />
        <span class="trust-text">
          <span class="trust-label">{b.label}</span>
          <span class="trust-sub">{b.sub}</span>
        </span>
      </div>
    ))}
  </div>

  <!-- Mobile marquee -->
  <div class="trust-marquee-wrap" aria-hidden="true">
    <div class="trust-marquee">
      {[...badges, ...badges].map(b => (
        <div class={`trust-badge trust-badge--${b.color} flex-shrink-0`}>
          <span class="trust-icon" set:html={b.icon} />
          <span class="trust-text">
            <span class="trust-label">{b.label}</span>
            <span class="trust-sub">{b.sub}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

<hr class="vintage-divider" />

<style>
.trust-bar-section {
  background: var(--bg-secondary);
  padding: 1.5rem 0;
  overflow: hidden;
}

/* ── Desktop: wrapping flex grid ── */
.trust-grid-desktop {
  display: none;
}

@media (min-width: 768px) {
  .trust-grid-desktop {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    padding: 0 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }
  .trust-marquee-wrap {
    display: none;
  }
}

/* ── Mobile: infinite marquee ── */
.trust-marquee-wrap {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
}

.trust-marquee {
  display: flex;
  gap: 0.75rem;
  width: max-content;
  animation: scroll-left 28s linear infinite;
  padding: 0.25rem 0;
}

@media (prefers-reduced-motion: reduce) {
  .trust-marquee { animation: none; }
}

/* ── Individual badge ── */
.trust-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.5rem 1rem;
  border-radius: 999px;
  border: 1px solid transparent;
  font-size: 0.78rem;
  transition: transform 0.25s ease, border-color 0.25s ease;
  white-space: nowrap;
  cursor: default;
}

.trust-badge:hover {
  transform: translateY(-2px);
}

/* Color variants */
.trust-badge--yellow {
  background: rgba(247, 181, 56, 0.08);
  border-color: rgba(247, 181, 56, 0.25);
  color: var(--accent-primary);
}
.trust-badge--yellow:hover { border-color: rgba(247, 181, 56, 0.5); }

.trust-badge--red {
  background: rgba(195, 47, 39, 0.08);
  border-color: rgba(195, 47, 39, 0.25);
  color: #e05050;
}
.trust-badge--red:hover { border-color: rgba(195, 47, 39, 0.5); }

.trust-badge--blue {
  background: rgba(30, 74, 138, 0.12);
  border-color: rgba(30, 74, 138, 0.30);
  color: #6aa0e0;
}
.trust-badge--blue:hover { border-color: rgba(45, 107, 191, 0.55); }

.trust-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  opacity: 0.9;
}

.trust-text {
  display: flex;
  flex-direction: column;
  gap: 0.05rem;
}

.trust-label {
  font-weight: 700;
  font-size: 0.78rem;
  line-height: 1.2;
}

.trust-sub {
  font-size: 0.62rem;
  opacity: 0.65;
  font-weight: 500;
  letter-spacing: 0.03em;
}
</style>
