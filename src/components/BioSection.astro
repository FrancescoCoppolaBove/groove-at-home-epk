---
import { Image } from 'astro:assets';

import session01 from '../assets/session_01.jpg';
import session02 from '../assets/session_02.jpg';
import session03 from '../assets/session_03.jpg';
import session04 from '../assets/session_04.jpg';
import session05 from '../assets/session_05.jpg';
import session06 from '../assets/session_06.jpg';
---

<section id="bio" class="relative py-20 md:py-24 overflow-hidden">
  <!-- bagliori soft -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 right-10 w-[560px] h-[560px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-secondary), transparent)"></div>
    <div class="absolute -bottom-32 left-0 w-[560px] h-[560px] rounded-full blur-3xl opacity-20"
      style="background: radial-gradient(closest-side, var(--accent-primary), transparent)"></div>
  </div>

  <div class="relative container-max px-6 md:px-12 lg:px-20">
    <!-- Header -->
    <div class="text-center mb-10 md:mb-12">
      <h2 class="text-[var(--accent-primary)] text-4xl md:text-5xl font-black mb-2">Bio</h2>
      <p class="text-lg md:text-xl text-[var(--text-secondary)]">Our Story</p>
    </div>

    <!-- Layout: su mobile SOLO testo; i collage compaiono da lg -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(680px,820px)_1fr] gap-10 items-start">
      
      <!-- Collage sinistra (desktop) -->
      <div class="relative hidden lg:block min-h-[720px]">
        <div class="absolute top-0 left-6 w-[56%] rotate-[-4deg] hover:rotate-[-2deg] transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session01} alt="Studio session 01" class="w-full h-[240px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
        <div class="absolute top-[180px] -left-4 w-[48%] rotate-[3deg] hover:rotate-[1deg] transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session02} alt="Recording take 02" class="w-full h-[220px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
        <div class="absolute top-[360px] left-[22%] w-[58%] rotate-[-2deg] hover:rotate-0 transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session03} alt="Behind the scenes 03" class="w-full h-[260px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
      </div>

      <!-- Testo (sempre visibile) -->
      <div class="relative mx-auto max-w-3xl">
        <div class="prose prose-invert prose-lg max-w-none leading-[2.0]">
          <p><strong>Groove at Home</strong> is an Italian collective founded by drummer <strong>Francesco Coppola Bove</strong>, reimagining Italian and international songs through a vibrant blend of funk, soul, and nu-jazz.</p>
          <p>Born as Francesco’s home-studio project, it quickly grew into a live ensemble known for deep grooves, tight musicianship, and a warm retro-modern aesthetic.</p>
          <p>The collective brings together musicians from across Italy, blending vintage funk energy with fresh, contemporary arrangements.</p>
          <p>Alongside their reinterpretations, Groove at Home is now developing original music, several of which are already performed live and will be featured on their first studio album, scheduled for 2026.</p>
          <p>The project has collaborated with acclaimed artists such as <strong>Francesca Tandoi</strong>, <strong>Mario Biondi</strong>, <strong>Arabella Rustico</strong> and many more, solidifying its presence in the soul-jazz scene.</p>
          <p>With over <strong>40,000 followers</strong> on Instagram and a <strong>collective of 100+ musicians</strong>, the group has built an engaged and international community around its sound.</p>
          <p>Their live shows are dynamic, soulful, and irresistibly groovy — a modern jam where musicians and audience move together as one.</p>
        </div>
      </div>

      <!-- Collage destra (desktop) -->
      <div class="relative hidden lg:block min-h-[760px]">
        <div class="absolute top-2 right-5 w-[54%] rotate-[5deg] hover:rotate-[3deg] transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session04} alt="Keys & rhythm 04" class="w-full h-[210px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
        <div class="absolute top-[180px] right-[30%] w-[62%] rotate-[-3deg] hover:rotate-[-1deg] transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session05} alt="Brass overdubs 05" class="w-full h-[260px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
        <div class="absolute top-[420px] right-4 w-[50%] rotate-[2deg] hover:rotate-0 transition-transform">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <Image src={session06} alt="Control room 06" class="w-full h-[240px] object-cover" loading="lazy" quality={90} format="webp" />
          </div>
        </div>
      </div>
    </div>

    <!-- 🔥 Nessuna foto su mobile: sezione rimossa -->
  </div>
</section>

<style>
  /* hover micro-interaction per desktop */
  #bio .rounded-2xl { transition: transform .25s ease, box-shadow .25s ease; }
  #bio .rounded-2xl:hover { transform: translateY(-3px) scale(1.01); }
</style>